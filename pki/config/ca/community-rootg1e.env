# Chain B root — SK ID Solutions ROOT G1E (Mobile-ID + Smart-ID hierarchy).
# Real: SK ID Solutions ROOT G1E, ECC P-521/SHA512, self-signed, 2021→2041, the
# shared root for the EID-Q / EID-NQ issuers (docs §2 chain B). Our id/CN carry the
# COMMUNITY prefix so they never clash with the real SK roots.
#
# NOTE: the real SK PKI has TWO parallel roots — ROOT G1E (ECC, active) and ROOT G1R
# (RSA-4096, backup, not issuing) — with E/R variants of every issuer. We reproduce
# ONLY the active ECC chain (this root + the *E issuers), the path live certs validate
# against; the RSA backup (G1R + *R issuers) is intentionally omitted. Add G1R only if a
# consumer pins the SK RSA backup root. See docs/real-world-pki.md §2 and §6 item 1.
CA_ID="community-rootg1e"
CA_CN="COMMUNITY TEST of SK ID Solutions ROOT G1E"
CA_TYPE="root"
CA_PARENT=""
CA_FAMILY="sk"

CA_KEY_ALG="ec"
CA_KEY_PARAM="secp521r1"
CA_DIGEST="sha512"
CA_DAYS="7305"          # ~20 years (real 2021–2041)
CA_PATHLEN="1"
CA_EKU=""               # roots carry no EKU
CA_POLICY_PROFILE="sk"  # CA cert policies: anyPolicy + CPS (representative subset)

# Issuer-side endpoints (used by certs this CA issues).
CA_CRL_URL="$PKI_HTTP_BASE/crl/community-rootg1e.crl"
CA_CAISSUER_URL="$PKI_HTTP_BASE/certs/community-rootg1e.crt"
CA_OCSP_URL="$PKI_OCSP_BASE/community-rootg1e"
