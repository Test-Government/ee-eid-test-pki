# Chain A1 issuing CA — legacy ID-card issuer (mirrors SK TEST of ESTEID2018).
# Real: ESTEID2018, ECC P-521/SHA512, under EE-GovCA2018, pathlen:0,
# technically-constrained sub-CA (EKU OCSPSigning/clientAuth/emailProtection).
CA_ID="community-esteid2018"
CA_CN="COMMUNITY TEST of ESTEID2018"
CA_TYPE="intermediate"
CA_PARENT="community-eegovca2018"
CA_FAMILY="idcard"

CA_KEY_ALG="ec"
CA_KEY_PARAM="secp521r1"
CA_DIGEST="sha512"
CA_DAYS="5475"
CA_PATHLEN="0"
# Real ESTEID2018 is a technically-constrained sub-CA carrying this EKU:
CA_EKU="critical,OCSPSigning,clientAuth,emailProtection"
CA_POLICY_PROFILE="esteid2018"   # CA cert policies: NCP+/QCP/citizen-ID(+CPS) subset (docs §3.1)

CA_CRL_URL="$PKI_HTTP_BASE/crl/community-esteid2018.crl"
CA_CAISSUER_URL="$PKI_HTTP_BASE/certs/community-esteid2018.crt"
CA_OCSP_URL="$PKI_OCSP_BASE/community-esteid2018"

# --- Leaf profile knobs (ESTEID2018 natural-person certs), per docs §3.1 ----
LEAF_KEY_ALG="ec"
LEAF_KEY_PARAM="secp384r1"        # leaves are P-384 even though the CA is P-521
LEAF_EKU_CRIT="critical,"         # 2018: extendedKeyUsage IS critical (docs §3.1b)
LEAF_BC_CRIT=""                   # basicConstraints CA:FALSE is non-critical on every leaf (docs §3)
LEAF_HAS_CDP="no"                 # 2018 profile: no CDP extension on the leaf (OCSP-only)
LEAF_POLICY_OID="1.3.6.1.4.1.51361.1.1.1"   # citizen-ID (docs §3.1 table; real TEST-of-ESTEID2018 leaves use this production-shaped OID)
LEAF_CPS_URL="https://www.sk.ee/CPS"
LEAF_QC_PDS_URL="https://sk.ee/en/repository/conditions-for-use-of-certificates/"
LEAF_VALIDITY_DAYS="1826"
