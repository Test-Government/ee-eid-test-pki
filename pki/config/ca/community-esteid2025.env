# Chain A2 issuing CA — current ID-card issuer (mirrors Zetes ESTEID2025).
# Real: ESTEID2025, ECC P-384/SHA384, under EEGovCA2025, pathlen:0.
CA_ID="community-esteid2025"
CA_CN="COMMUNITY Test ESTEID2025"
CA_TYPE="intermediate"
CA_PARENT="community-eegovca2025"
CA_FAMILY="idcard"

CA_KEY_ALG="ec"
CA_KEY_PARAM="secp384r1"
CA_DIGEST="sha384"
CA_DAYS="5475"
CA_PATHLEN="0"
CA_EKU=""              # ESTEID2025 sub-CA EKU unconfirmed — omit (see docs §3.1b [U])
CA_POLICY_PROFILE="esteid2025"   # CA cert policies: anyPolicy + CPS (docs §3.1b)

CA_CRL_URL="$PKI_HTTP_BASE/crl/community-esteid2025.crl"
CA_CAISSUER_URL="$PKI_HTTP_BASE/certs/community-esteid2025.crt"
CA_OCSP_URL="$PKI_OCSP_BASE/community-esteid2025"

# --- Leaf profile knobs (ESTEID2025 natural-person certs), per docs §3.1b ---
LEAF_KEY_ALG="ec"
LEAF_KEY_PARAM="secp384r1"
LEAF_EKU_CRIT=""                 # 2025: extendedKeyUsage is NON-critical
LEAF_BC_CRIT=""                  # 2025: basicConstraints is NON-critical
LEAF_HAS_CDP="yes"               # 2025 leaves carry a CRL distribution point
LEAF_POLICY_ETSI_FIRST="yes"     # 2025 lists NCP+/QCP before the doc-type policy (docs §3.1b)
LEAF_POLICY_OID="2.999.1.3.6.1.4.1.51361.2.1.1"   # test citizen-ID (2.999. test prefix)
LEAF_CPS_URL="https://repository-test.eidpki.ee"
LEAF_QC_PDS_URL="https://repository-test.eidpki.ee"
LEAF_VALIDITY_DAYS="1826"
