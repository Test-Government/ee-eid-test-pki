# Chain A1 root — legacy government ID-card root (mirrors SK TEST of EE-GovCA2018).
# Real: EE-GovCA2018, ECC P-521/SHA512, self-signed, 2018-2033.
CA_ID="community-eegovca2018"
CA_CN="COMMUNITY TEST of EE-GovCA2018"
CA_TYPE="root"
CA_PARENT=""
CA_FAMILY="idcard"

CA_KEY_ALG="ec"
CA_KEY_PARAM="secp521r1"
CA_DIGEST="sha512"
CA_DAYS="5478"
CA_PATHLEN="1"
CA_EKU=""
CA_POLICY_PROFILE="esteid2018"   # CA cert policies: NCP+/QCP/citizen-ID(+CPS) subset (docs §3.1)

CA_CRL_URL="$PKI_HTTP_BASE/crl/community-eegovca2018.crl"
CA_CAISSUER_URL="$PKI_HTTP_BASE/certs/community-eegovca2018.crt"
CA_OCSP_URL="$PKI_OCSP_BASE/community-eegovca2018"
