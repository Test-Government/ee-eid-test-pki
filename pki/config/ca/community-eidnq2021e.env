# Chain B issuing CA — Smart-ID NON-QUALIFIED issuer (mirrors SK EID-NQ 2021E).
# Real: SK ID Solutions EID-NQ 2021E, ECC P-384/ecdsa-SHA384, under ROOT G1E,
# pathlen:0. Current Smart-ID non-qualified issuer (docs §2, §3.3).
CA_ID="community-eidnq2021e"
CA_CN="COMMUNITY TEST of SK ID Solutions EID-NQ 2021E"
CA_TYPE="intermediate"
CA_PARENT="community-rootg1e"
CA_FAMILY="smartid"

CA_KEY_ALG="ec"
CA_KEY_PARAM="secp384r1"
CA_DIGEST="sha384"
CA_DAYS="5475"
CA_PATHLEN="0"
CA_EKU=""               # SK EID-Q/EID-NQ issuers carry no EKU
CA_POLICY_PROFILE="sk"

CA_CRL_URL="$PKI_HTTP_BASE/crl/community-eidnq2021e.crl"
CA_CAISSUER_URL="$PKI_HTTP_BASE/certs/community-eidnq2021e.crt"
CA_OCSP_URL="$PKI_OCSP_BASE/community-eidnq2021e"

# --- Leaf profile knobs (Smart-ID NON-QUALIFIED natural-person certs), per docs §3.3 ---
# Non-qualified: NCP (not NCP+/QCP) and NO qcStatements; auth EKU + RSA key as qualified.
# Real policy OID kept (no 2.999. prefix — decision D1).
SMARTID_QUALIFIED="no"
LEAF_KEY_ALG="rsa"
LEAF_KEY_PARAM="${SMARTID_KEY_BITS:-6144}"        # RSA-6144; set SMARTID_KEY_BITS=2048 for fast dev builds (decision D3)
LEAF_VALIDITY_DAYS="1095"                          # 3 years
LEAF_HAS_CDP="yes"
LEAF_SID_POLICY_OID="1.3.6.1.4.1.10015.17.1"      # SK Smart-ID non-qualified policy (real OID)
LEAF_AUTH_EKU_OID="1.3.6.1.4.1.62306.5.7.0"       # SK "Smart-ID Authentication" EKU (real, functional)
LEAF_CPS_URL="https://www.skidsolutions.eu/resources/certification-practice-statement/"   # CPS on the SK policy
LEAF_QC_PDS_URL=""                                 # non-qualified: no qcStatements / QcPDS
