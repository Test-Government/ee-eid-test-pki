# Chain A2 root — current government ID-card root (mirrors Zetes EEGovCA2025).
# Real: EEGovCA2025, ECC P-384/SHA384, self-signed, 2025-2040, pathlen:1.
# Our id/artifacts are prefixed "community-" so they never clash with a client's
# real EEGovCA2025 files; the cert CN keeps the matching "COMMUNITY " prefix.
CA_ID="community-eegovca2025"
CA_CN="COMMUNITY Test EEGovCA2025"
CA_TYPE="root"
CA_PARENT=""
CA_FAMILY="idcard"

CA_KEY_ALG="ec"
CA_KEY_PARAM="secp384r1"
CA_DIGEST="sha384"
CA_DAYS="5478"          # ~15 years
CA_PATHLEN="1"
CA_EKU=""              # roots carry no EKU
CA_POLICY_PROFILE="esteid2025"   # CA cert policies: anyPolicy + CPS (docs §3.1b)

# Issuer-side endpoints (used by certs this CA issues).
CA_CRL_URL="$PKI_HTTP_BASE/crl/community-eegovca2025.crl"
CA_CAISSUER_URL="$PKI_HTTP_BASE/certs/community-eegovca2025.crt"
CA_OCSP_URL="$PKI_OCSP_BASE/community-eegovca2025"
