# Chain B issuing CA — Smart-ID QUALIFIED issuer (mirrors SK EID-Q 2024E).
# Real: SK ID Solutions EID-Q 2024E, ECC P-384/ecdsa-SHA384, under ROOT G1E,
# pathlen:0. Current Smart-ID qualified issuer since 2024-11-27 (docs §2, §3.3).
CA_ID="community-eidq2024e"
CA_CN="COMMUNITY TEST of SK ID Solutions EID-Q 2024E"
CA_TYPE="intermediate"
CA_PARENT="community-rootg1e"
CA_FAMILY="smartid"

CA_KEY_ALG="ec"
CA_KEY_PARAM="secp384r1"
CA_DIGEST="sha384"
CA_DAYS="5475"
CA_PATHLEN="0"
CA_EKU=""               # SK EID-Q/EID-NQ issuers carry no EKU
CA_POLICY_PROFILE="sk"

CA_CRL_URL="$PKI_HTTP_BASE/crl/community-eidq2024e.crl"
CA_CAISSUER_URL="$PKI_HTTP_BASE/certs/community-eidq2024e.crt"
CA_OCSP_URL="$PKI_OCSP_BASE/community-eidq2024e"

# --- Leaf profile knobs (Smart-ID QUALIFIED natural-person certs), per docs §3.3 ---
# SK DEMO/test certs keep the REAL policy OIDs (test-ness is via the CA name), so no
# 2.999. prefix here — unlike the ESTEID2025 test card (docs §4.2). (decision D1)
SMARTID_QUALIFIED="yes"
LEAF_KEY_ALG="rsa"
LEAF_KEY_PARAM="${SMARTID_KEY_BITS:-6144}"        # RSA-6144; set SMARTID_KEY_BITS=2048 for fast dev builds (decision D3)
LEAF_VALIDITY_DAYS="1095"                          # 3 years
LEAF_HAS_CDP="yes"
LEAF_SID_POLICY_OID="1.3.6.1.4.1.10015.17.2"      # SK Smart-ID qualified policy (real OID)
LEAF_AUTH_EKU_OID="1.3.6.1.4.1.62306.5.7.0"       # SK "Smart-ID Authentication" EKU (real, functional)
LEAF_CPS_URL="https://www.skidsolutions.eu/resources/certification-practice-statement/"   # CPS on the SK policy
LEAF_QC_PDS_URL="https://www.skidsolutions.eu/resources/conditions-for-use-of-certificates/"
