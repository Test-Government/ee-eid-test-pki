# Global settings shared by every CA in this test PKI.
# Sourced (as bash) by pki/lib/common.sh before any per-CA env.
#
# See docs/real-world-pki.md §6 for the naming/identity convention.

# Every value uses ":=" so an exported environment variable (e.g. a Docker
# build ARG) overrides the default without editing this file.

# --- Neutral community identity for ALL our CAs ----------------------------
# We deliberately do NOT reuse the real operators' organisation values
# (Zetes Estonia OÜ / SK ID Solutions AS) — see docs §6 "Naming & identity".
: "${ORG_C:=EE}"
: "${ORG_O:=EE eID Community Test PKI}"
: "${ORG_ORGID:=NTREE-00000000}"   # placeholder, deliberately fake

# Country placed in the subject of natural-person leaf certificates.
: "${PERSON_C:=EE}"

# --- Serving endpoints ------------------------------------------------------
# CRL / CA-cert (HTTP) and OCSP responder base URLs baked into issued certs.
# Default host.docker.internal lets certs issued in the container be validated
# from sibling containers via published ports. Override to bake a compose
# service name (http://eid-test-pki:8080) or a public URL
# (https://pki.example.com) instead — at Docker build time
# (--build-arg PKI_HTTP_BASE=..., PKI_OCSP_BASE=...) or at container run time
# (-e PKI_HTTP_BASE=... -e REGENERATE=1; the runtime image re-exports both).
#
# NOTE: an overridden base is baked into newly-issued LEAVES. Pinned CA certs
# keep the URLs frozen when they were pinned (gen-ca.sh warns on divergence);
# use FRESH_CA=1 or bring-your-own fixtures to change CA-level URLs.
: "${PKI_HTTP_BASE:=http://host.docker.internal:8080}"
: "${PKI_OCSP_BASE:=http://host.docker.internal:8081}"