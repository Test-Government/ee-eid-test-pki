# OpenSSL config for an ID-card natural-person leaf (ESTEID2018 / ESTEID2025).
# Rendered per leaf; carries the person's subject DN and the issuer's URLs.
# Signed by the issuing CA via `openssl ca -extfile <this> -extensions ext_auth|ext_sign`.
# Generation-specific bits (EKU/BC criticality, CDP presence, policy OID, URLs)
# are supplied from the issuing CA's env — see docs §3.1 / §3.1b.

[ req ]
default_bits       = 2048
distinguished_name = req_dn
prompt             = no
utf8               = yes
string_mask        = utf8only

# Natural-person subject. serialNumber uses the ETSI EN 319 412-1 PNOEE- form;
# CN is "SURNAME,GIVENNAME,PERSONALCODE".
[ req_dn ]
C            = @P_C@
serialNumber = @P_SERIALNUMBER@
givenName    = @P_GIVENNAME@
surname      = @P_SURNAME@
CN           = @P_CN@

# --- Authentication certificate -------------------------------------------
[ ext_auth ]
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid:always
basicConstraints       = @LEAF_BC_CRIT@CA:false
keyUsage               = critical,digitalSignature,keyAgreement
extendedKeyUsage       = @LEAF_EKU_CRIT@clientAuth,emailProtection
certificatePolicies    = @POLICIES_AUTH@
@CDP_LINE_AUTH@
authorityInfoAccess    = @aia
subjectAltName         = @san_auth
qcStatements           = ASN1:SEQUENCE:qc_seq_auth

# --- Signature (QES) certificate ------------------------------------------
[ ext_sign ]
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid:always
basicConstraints       = @LEAF_BC_CRIT@CA:false
keyUsage               = critical,nonRepudiation
certificatePolicies    = @POLICIES_SIGN@
@CDP_LINE_SIGN@
authorityInfoAccess    = @aia
qcStatements           = ASN1:SEQUENCE:qc_seq_sign

# --- Shared sections -------------------------------------------------------
[ aia ]
caIssuers;URI.0 = @ISSUER_CAISSUER_URL@
OCSP;URI.0      = @ISSUER_OCSP_URL@

[ san_auth ]
email = @P_EMAIL@

[ pol_doctype ]
policyIdentifier = @LEAF_POLICY_OID@
@CPS_LINE@

[ pol_ncp ]
policyIdentifier = 0.4.0.2042.1.2

[ pol_qcp ]
policyIdentifier = 0.4.0.194112.1.2

# qcStatements. auth = QcCompliance + QcPDS (a qualified cert, but not for
# signing, so no QcSSCD/QcType). sign adds QcSSCD + QcType=esign. (docs §3.1)
[ qc_seq_auth ]
s1 = SEQUENCE:qc_compliance
s2 = SEQUENCE:qc_pds

[ qc_seq_sign ]
s1 = SEQUENCE:qc_compliance
s2 = SEQUENCE:qc_sscd
s3 = SEQUENCE:qc_type
s4 = SEQUENCE:qc_pds

[ qc_compliance ]
id = OID:0.4.0.1862.1.1

[ qc_sscd ]
id = OID:0.4.0.1862.1.4

[ qc_type ]
id   = OID:0.4.0.1862.1.6
info = SEQUENCE:qc_type_ids
[ qc_type_ids ]
t = OID:0.4.0.1862.1.6.1

[ qc_pds ]
id   = OID:0.4.0.1862.1.5
info = SEQUENCE:qc_pds_locs
[ qc_pds_locs ]
loc = SEQUENCE:qc_pds_en
[ qc_pds_en ]
url  = IA5STRING:@LEAF_QC_PDS_URL@
lang = PRINTABLESTRING:en